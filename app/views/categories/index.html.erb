<p style="color: green"><%= notice %></p>

<% content_for :title, "Categorias" %>

<h1>Categorias</h1>

<div id="categories">
  <% @categories.each do |category| %>
    <%= render category %>
    <p>
      <%= link_to "Mostrar esta categoria", category %>
    </p>
  <% end %>
</div>

<%= link_to "Nova categoria", new_category_path %>
