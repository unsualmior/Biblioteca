<div id="<%= dom_id library_user %>">
  <div>
    <strong>Nome completo:</strong>
    <%= library_user.full_name %>
  </div>

  <div>
    <strong>Cpf:</strong>
    <%= library_user.cpf %>
  </div>

  <div>
    <strong>Celular:</strong>
    <%= library_user.phone %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= library_user.email %>
  </div>

  <div>
    <strong>Senha de empréstimo:</strong>
    <%= library_user.loan_password %>
  </div>

</div>
