<%= form_with(model: library_user) do |form| %>
  <% if library_user.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(library_user.errors.count, "error") %> prohibited this library_user from being saved:</h2>

      <ul>
        <% library_user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :full_name, "Nome completo", style: "display: block" %>
    <%= form.text_field :full_name %>
  </div>

  <div>
    <%= form.label :cpf, "CPF", style: "display: block" %>
    <%= form.text_field :cpf %>
  </div>

  <div>
    <%= form.label :phone, "Telefone", style: "display: block" %>
    <%= form.text_field :phone %>
  </div>

  <div>
    <%= form.label :email, "E-mail", style: "display: block" %>
    <%= form.text_field :email %>
  </div>

  <div>
    <%= form.submit "Atualizar usuário da biblioteca" %>
  </div>
<% end %>
