<div id="<%= dom_id book %>">
  <div>
    <strong>ID:</strong>
    <%= book.id %>
  </div>

  <div>
    <strong>Título:</strong>
    <%= book.title %>
  </div>

  <div>
    <strong>Autor:</strong>
    <%= book.author %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= book.status %>
  </div>

  <div>
    <strong>Notas:</strong>
    <%= book.notes %>
  </div>

  <div>
    <strong>Categoria:</strong>
    <%= book.category.name %>
  </div>

</div>
